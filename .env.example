# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` — it holds secrets. See README.md.
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_IDS=123456789
FORCE_CHANNELS=@ange1Vpn
# Optional: comma-separated invite links used by the join-check button,
# one per channel in FORCE_CHANNELS (leave empty to skip).
# FORCE_JOIN_URLS=
# Optional: local Telegram Bot API server for the 2 GB file cap
# (see docs/DEPLOY.md). Leave empty to use the cloud API (49 MB cap).
# LOCAL_BOT_API=http://127.0.0.1:8081
DB_PATH=data.db
