# Local Telegram Bot API server — adjust paths if you install elsewhere (see docs/DEPLOY.md)
[Unit]
Description=Telegram Bot API server (local, for AngelDl bot)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/root/dlbot/api.env
ExecStart=/usr/local/bin/telegram-bot-api --api-id=${API_ID} --api-hash=${API_HASH} --local --http-port=8081 --dir=/var/lib/telegram-bot-api --verbosity=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
